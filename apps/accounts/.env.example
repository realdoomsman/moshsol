# Copy to apps/accounts/.env (gitignored). See README → Accounts (Sign in with Google) and Environment.

# Google OAuth Web client
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# 64 hex chars (`openssl rand -hex 32`): AES-256-GCM key sealing every custodial wallet. Losing it loses funds.
WALLET_MASTER_KEY=
# >= 32 chars (`openssl rand -hex 32`): HMAC key for session ids and OAuth states
SESSION_SECRET=

# Public origin of the web app (plain http only on localhost)
SITE_URL=http://localhost:3000

# Optional (defaults shown)
# ACCOUNTS_PORT=8789
# RATE_LIMIT_PER_MIN=120
# SIGN_LIMIT_PER_MIN=30
# TRUST_PROXY=
# LOG_LEVEL=info
