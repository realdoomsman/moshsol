{
  "name": "holdfast",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "dev": "pnpm -s preflight && concurrently --kill-others --names indexer,agent,accounts,web --prefix-colors cyan,magenta,yellow,green \"pnpm:dev:indexer\" \"pnpm:dev:agent\" \"pnpm:dev:accounts\" \"pnpm:dev:web\"",
    "start": "pnpm -s preflight && pnpm --filter @holdfast/web build && concurrently --kill-others --names indexer,agent,accounts,web --prefix-colors cyan,magenta,yellow,green \"pnpm --filter @holdfast/indexer start\" \"pnpm --filter @holdfast/agent start\" \"pnpm --filter @holdfast/accounts start\" \"pnpm --filter @holdfast/web start\"",
    "dev:web": "pnpm --filter @holdfast/web dev",
    "dev:indexer": "pnpm --filter @holdfast/indexer dev",
    "dev:agent": "pnpm --filter @holdfast/agent dev",
    "dev:accounts": "pnpm --filter @holdfast/accounts dev",
    "preflight": "pnpm --silent --filter @holdfast/scripts run preflight",
    "localnet": "node scripts/localnet.mjs",
    "stop:localnet": "node scripts/localnet.mjs stop",
    "reset:localnet": "node scripts/localnet.mjs reset",
    "setup:localnet": "pnpm --filter @holdfast/scripts run setup",
    "seed:localnet": "pnpm --filter @holdfast/scripts run seed",
    "simulate:localnet": "pnpm --filter @holdfast/scripts run simulate",
    "handoff": "pnpm --filter @holdfast/scripts run handoff",
    "upgrade": "pnpm --filter @holdfast/scripts run upgrade",
    "migrate:launches": "pnpm --filter @holdfast/scripts run migrate",
    "typecheck": "pnpm -r typecheck",
    "vault:withdraw": "pnpm --filter @holdfast/scripts run vault-withdraw",
    "vault:dev-withdraw": "pnpm --filter @holdfast/scripts run dev-withdraw"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
